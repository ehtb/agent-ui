{
  "name": "agent-ui-example-with-tailwind",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "agent-ui with Tailwind CSS: utility classes in the spec, style.css generated by the Tailwind CLI.",
  "scripts": {
    "css": "tailwindcss -i input.css -o pages/page.css",
    "css:watch": "tailwindcss -i input.css -o pages/page.css --watch",
    "build": "npm run css && agent-ui build",
    "dev": "npm run css && agent-ui dev",
    "serve": "agent-ui serve",
    "start": "npm run build && agent-ui serve",
    "test": "node --test"
  },
  "dependencies": {
    "@ehtb/agent-ui": "file:../.."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
